{
  "name": "nanobanana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": ["apps/*", "apps/api/contracts"],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@nanobanana/web",
    "dev:api": "npm run dev --workspace=@nanobanana/api",
    "dev:server": "npm run dev:api",
    "debug:api": "npm run debug --workspace=@nanobanana/api",
    "start": "npm run start:api",
    "start:web": "npm run start --workspace=@nanobanana/web",
    "start:api": "npm run start --workspace=@nanobanana/api",
    "build": "npm run build:api && npm run build:web",
    "build:web": "npm run build --workspace=@nanobanana/web",
    "build:api": "npm run build --workspace=@nanobanana/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --workspace=@nanobanana/api",
    "test:web": "npm run test --workspace=@nanobanana/web",
    "test:contracts": "npm run test:contracts --workspace=@nanobanana/api",
    "test:server": "npm test",
    "lint": "eslint .",
    "lint:web": "npm run lint --workspace=@nanobanana/web",
    "lint:api": "npm run lint --workspace=@nanobanana/api",
    "preview": "npm run preview --workspace=@nanobanana/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
