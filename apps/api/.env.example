# Reference only: Spring Boot reads process environment, not this file automatically.
PORT=3001
BIND_ADDRESS=127.0.0.1
DATABASE_URL=jdbc:postgresql://localhost:5432/studio
DATABASE_USER=studio
DATABASE_PASSWORD=
# Relative to the Java process working directory; npm runs this app from apps/api.
DATA_DIR=./data-java
# A 32-byte base64 key, or blank to generate a durable master.key in DATA_DIR.
ENCRYPTION_KEY=
PROVIDER_TIMEOUT_SECONDS=600
# true behind public HTTPS; false only for local HTTP development.
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
