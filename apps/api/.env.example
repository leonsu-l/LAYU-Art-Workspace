# Backend-only configuration, loaded from apps/api/.env.
# If PORT changes, update VITE_API_PROXY_TARGET in apps/web/.env as well.
PORT=3001
# Relative to apps/api, or an absolute path. Keep this directory private.
# Persisted tasks and images belong to this API application, not the repository root.
DATA_DIR=data
# Backend supplier request timeout (milliseconds); clamped to 15000..600000.
IMAGE_REQUEST_TIMEOUT_MS=180000
