{
  "name": "@nanobanana/api",
  "private": true,
  "version": "0.0.0",
  "description": "Java 21 / Spring Boot backend command wrappers",
  "scripts": {
    "dev": "mvn spring-boot:run",
    "debug": "mvn spring-boot:run -Dspring-boot.run.jvmArguments=\"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=127.0.0.1:5005\"",
    "start": "java -jar target/studio-api-1.0.0.jar",
    "typecheck": "mvn -q -DskipTests compile",
    "build": "mvn -B -ntp -DskipTests package",
    "test": "mvn -B -ntp test",
    "test:contracts": "mvn -B -ntp -Dtest=ProviderServiceTest test",
    "lint": "mvn -q -DskipTests compile"
  }
}
