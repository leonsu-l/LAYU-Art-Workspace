# Loopback HTTP port for BaoTa Nginx reverse proxy; no public 80/443 binding.
WEB_PORT=8080
# Required; choose a strong unique database password.
DATABASE_PASSWORD=
# First startup only: create the initial administrator. There is no default account/password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Keep true when BaoTa serves the public site over HTTPS, even though the internal proxy uses HTTP.
COOKIE_SECURE=true
# Optional 32 random bytes encoded as base64. If blank, a persistent master.key is generated in studio_data.
ENCRYPTION_KEY=
PROVIDER_TIMEOUT_SECONDS=600
# Local-only HTTP trial at http://localhost:8080: COOKIE_SECURE=false.
